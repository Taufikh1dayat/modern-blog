---
import PageLayout from '../layouts/PageLayout.astro'
---

<PageLayout title="Kontak" description="Hubungi kami.">
  <div class="max-w-2xl">
    <p class="text-primary-700 dark:text-primary-300">
      Punya pertanyaan, saran, atau ingin berkolaborasi? Silakan hubungi melalui media sosial di bawah ini.
    </p>

    <!-- Social Links -->
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="https://www.linkedin.com/in/m-taufik-hidayat-051541240/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 rounded-xl border border-primary-200 bg-white px-6 py-4 text-sm font-medium text-primary-700 transition-all hover:border-primary-300 hover:shadow-md hover:-translate-y-0.5 dark:border-primary-800 dark:bg-primary-900 dark:text-primary-300 dark:hover:border-primary-600"
      >
        <svg class="h-6 w-6 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        <span>M Taufik Hidayat</span>
      </a>
    </div>

    <form
      class="mt-8 space-y-4"
      onsubmit="event.preventDefault(); alert('Fitur kontak masih dalam pengembangan. Silakan hubungi melalui LinkedIn.')"
    >
      <div>
        <label for="name" class="mb-1 block text-sm font-medium text-primary-700 dark:text-primary-300">Nama</label>
        <input
          type="text"
          id="name"
          class="w-full rounded-lg border border-primary-300 bg-white px-4 py-2 text-sm text-primary-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-primary-700 dark:bg-primary-900 dark:text-primary-100"
          placeholder="Nama kamu"
        />
      </div>
      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-primary-700 dark:text-primary-300">Email</label>
        <input
          type="email"
          id="email"
          class="w-full rounded-lg border border-primary-300 bg-white px-4 py-2 text-sm text-primary-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-primary-700 dark:bg-primary-900 dark:text-primary-100"
          placeholder="email@contoh.com"
        />
      </div>
      <div>
        <label for="message" class="mb-1 block text-sm font-medium text-primary-700 dark:text-primary-300">Pesan</label>
        <textarea
          id="message"
          rows="5"
          class="w-full rounded-lg border border-primary-300 bg-white px-4 py-2 text-sm text-primary-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-primary-700 dark:bg-primary-900 dark:text-primary-100"
          placeholder="Tulis pesan kamu..."
        ></textarea>
      </div>
      <button
        type="submit"
        class="rounded-lg bg-primary-950 px-6 py-3 text-sm font-medium text-white transition-all hover:bg-primary-800 dark:bg-primary-50 dark:text-primary-950 dark:hover:bg-primary-200"
      >
        Kirim Pesan
      </button>
    </form>
  </div>
</PageLayout>
