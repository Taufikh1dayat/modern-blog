---
import PageLayout from '../layouts/PageLayout.astro'
---

<PageLayout title="Kontak" description="Hubungi kami.">
  <div class="prose-custom max-w-2xl">
    <p>
      Punya pertanyaan, saran, atau ingin berkolaborasi? Silakan kirim pesan melalui formulir di
      bawah ini atau hubungi kami melalui media sosial.
    </p>
    <form
      class="mt-8 space-y-4"
      onsubmit="event.preventDefault(); alert('Fitur kontak masih dalam pengembangan. Silakan hubungi kami melalui GitHub.')"
    >
      <div>
        <label for="name" class="mb-1 block text-sm font-medium text-primary-700 dark:text-primary-300">Nama</label>
        <input
          type="text"
          id="name"
          class="w-full rounded-lg border border-primary-300 bg-white px-4 py-2 text-sm text-primary-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20 dark:border-primary-700 dark:bg-primary-900 dark:text-primary-100"
          placeholder="Nama kamu"
        />
      </div>
      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-primary-700 dark:text-primary-300">Email</label>
        <input
          type="email"
          id="email"
          class="w-full rounded-lg border border-primary-300 bg-white px-4 py-2 text-sm text-primary-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20 dark:border-primary-700 dark:bg-primary-900 dark:text-primary-100"
          placeholder="email@contoh.com"
        />
      </div>
      <div>
        <label for="message" class="mb-1 block text-sm font-medium text-primary-700 dark:text-primary-300">Pesan</label>
        <textarea
          id="message"
          rows="5"
          class="w-full rounded-lg border border-primary-300 bg-white px-4 py-2 text-sm text-primary-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20 dark:border-primary-700 dark:bg-primary-900 dark:text-primary-100"
          placeholder="Tulis pesan kamu..."
        ></textarea>
      </div>
      <button
        type="submit"
        class="rounded-lg bg-accent-600 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-700"
      >
        Kirim Pesan
      </button>
    </form>
  </div>
</PageLayout>
