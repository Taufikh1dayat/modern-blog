---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout title="Pencarian" description="Cari artikel di blog.">
  <Navbar />
  <main class="flex-1">
    <div class="container-page py-16">
      <h1 class="text-4xl font-bold tracking-tight text-primary-50">
        Pencarian
      </h1>
      <div class="mt-6">
        <input
          id="pagefind-search"
          type="search"
          class="w-full rounded-xl border border-primary-700 bg-primary-900 px-4 py-3 text-primary-100 placeholder-primary-500 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/20"
          placeholder="Cari artikel..."
        />
      </div>
      <div id="search-results-page" class="mt-8"></div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const input = document.getElementById('pagefind-search')
  const resultsContainer = document.getElementById('search-results-page')

  if (input && resultsContainer) {
    let debounceTimer

    input.addEventListener('input', async () => {
      clearTimeout(debounceTimer)
      const query = input.value.trim()

      if (!query) {
        resultsContainer.innerHTML = '<p class="text-center text-primary-400 py-8">Ketik kata kunci untuk mencari artikel.</p>'
        return
      }

      debounceTimer = setTimeout(async () => {
        resultsContainer.innerHTML = '<p class="text-center text-primary-400 py-8">Mencari...</p>'

        try {
          const pagefind = await import('/pagefind/pagefind.js')
          const search = await pagefind.search(query)
          const results = await Promise.all(
            search.results.slice(0, 20).map((r) => r.data())
          )

          if (results.length === 0) {
            resultsContainer.innerHTML =
              '<div class="text-center py-12"><p class="text-primary-500">Tidak ditemukan hasil untuk "<strong>' + query + '</strong>"</p></div>'
            return
          }

          resultsContainer.innerHTML =
            '<p class="mb-4 text-sm text-primary-500">Menampilkan ' +
            results.length +
            ' hasil untuk "' +
            query +
            '"</p>' +
            results
              .map(
                (r) =>
                  '<a href="' +
                  r.url +
                  '" class="flex flex-col gap-1 rounded-lg border border-primary-200 dark:border-primary-800 p-4 mb-3 transition-colors hover:bg-primary-50 dark:hover:bg-primary-900">' +
                  '<span class="font-medium text-primary-950 dark:text-primary-50">' +
                  r.meta.title +
                  '</span>' +
                  '<span class="text-sm text-primary-500 line-clamp-2">' +
                  r.excerpt +
                  '</span>' +
                  '</a>'
              )
              .join('')
        } catch {
          resultsContainer.innerHTML = '<p class="text-center text-red-500 py-8">Gagal memuat pencarian. Coba refresh halaman.</p>'
        }
      }, 300)
    })
  }
</script>
