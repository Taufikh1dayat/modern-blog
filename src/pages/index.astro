---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import Hero from '../components/Hero.astro'
import ArticleCard from '../components/ArticleCard.astro'
import CategoryCard from '../components/CategoryCard.astro'
import { SITE, BLOG } from '../config/site'
import { getCollection } from 'astro:content'
import { getReadingTime } from '../utils/readingTime'
import { getFeaturedPosts, getLatestPosts, getCategories } from '../utils/sortPosts'
import type { Post } from '../types/blog'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .map((entry) => ({
    ...entry,
    ...entry.data,
    slug: entry.slug,
    readingTime: getReadingTime(entry.body),
  })) as Post[]

const featured = getFeaturedPosts(posts, BLOG.featuredPostsCount)
const latest = getLatestPosts(posts)
const categories = getCategories(posts)
---

<BaseLayout title="Beranda">
  <Navbar />
  <main>
    <Hero />

    <!-- Featured Articles -->
    {featured.length > 0 && (
      <section class="border-b border-primary-800/50 py-16">
        <div class="container-page">
          <h2 class="animate-fade-up mb-10 text-2xl font-bold text-primary-50">
            Artikel Pilihan
          </h2>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {featured.slice(0, 1).map((post) => (
              <div class="lg:col-span-2">
                <ArticleCard post={post} variant="featured" />
              </div>
            ))}
            {featured.slice(1, 3).map((post) => <ArticleCard post={post} />)}
          </div>
        </div>
      </section>
    )}

    <!-- Latest Articles -->
    <section class="border-b border-primary-800/50 py-16">
      <div class="container-page">
        <h2 class="animate-fade-up mb-10 text-2xl font-bold text-primary-50">
          Artikel Terbaru
        </h2>
        {latest.length > 0 ? (
          <>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {latest.map((post) => <ArticleCard post={post} />)}
            </div>
            <div class="mt-10 text-center">
              <a
                href="/articles"
                class="inline-block rounded-xl border border-primary-700 bg-primary-900/50 px-8 py-3.5 text-sm font-medium text-primary-300 transition-all hover:border-primary-500 hover:text-primary-50 hover:bg-primary-800/50 hover:scale-105 active:scale-95"
              >
                Lihat Semua Artikel
              </a>
            </div>
          </>
        ) : (
          <div class="rounded-xl border border-dashed border-primary-700 p-16 text-center">
            <p class="text-primary-500">Belum ada artikel. Nantikan konten terbaru dari kami!</p>
          </div>
        )}
      </div>
    </section>

    <!-- Categories -->
    {categories.length > 0 && (
      <section class="py-16">
        <div class="container-page">
          <h2 class="animate-fade-up mb-10 text-2xl font-bold text-primary-50">
            Kategori
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {categories.map((cat) => <CategoryCard name={cat.name} count={cat.count} />)}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
