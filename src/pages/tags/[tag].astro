---
import PageLayout from '../../layouts/PageLayout.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import { getCollection } from 'astro:content'
import { getReadingTime } from '../../utils/readingTime'
import { getPostsByTag } from '../../utils/sortPosts'
import type { Post } from '../../types/blog'

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .map((entry) => ({
      ...entry,
      ...entry.data,
      slug: entry.slug,
      readingTime: getReadingTime(entry.body),
    })) as Post[]

  const allTags = [...new Set(posts.flatMap((p) => p.tags))]
  return allTags.map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: { tag, posts },
  }))
}

const { tag, posts } = Astro.props
const filtered = getPostsByTag(posts, tag)
---

<PageLayout title={`Tag: #${tag}`} description={`Artikel dengan tag ${tag}.`}>
  {filtered.length > 0 ? (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {filtered.map((post) => <ArticleCard post={post} />)}
    </div>
  ) : (
    <div class="rounded-xl border border-dashed border-primary-700 p-16 text-center">
      <p class="text-primary-500">Tidak ada artikel dengan tag ini.</p>
    </div>
  )}
</PageLayout>
