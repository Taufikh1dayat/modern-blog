---
import type { Post } from '../types/blog'
import { formatDateShort } from '../utils/formatDate'

export interface Props {
  post: Post
  variant?: 'default' | 'featured'
}

const { post, variant = 'default' } = Astro.props
const isFeatured = variant === 'featured'
---

<article class="group rounded-xl border border-primary-800 bg-primary-900/50 transition-all hover:border-primary-600 hover:bg-primary-900 hover:shadow-lg hover:shadow-accent-500/5 hover:-translate-y-1">
  <a href={`/articles/${post.slug}`} class={`block h-full ${isFeatured ? 'flex flex-col justify-between gap-4 p-6 lg:flex-row lg:items-center lg:p-8' : 'p-5'}`}>
    <div class="${isFeatured ? 'flex-1' : ''}">
      <!-- Category Badge -->
      {post.category && (
        <span class="mb-3 inline-block rounded-full bg-accent-900/50 px-3 py-1 text-xs font-medium text-accent-300">
          {post.category}
        </span>
      )}

      <!-- Title -->
      <h3 class={`font-semibold leading-snug text-primary-50 transition-colors group-hover:text-accent-400 ${isFeatured ? 'text-2xl lg:text-3xl' : 'text-lg'}`}>
        {post.title}
      </h3>

      <!-- Description -->
      {post.description && (
        <p class={`mt-2 text-primary-400 line-clamp-2 ${isFeatured ? 'text-base' : 'text-sm'}`}>
          {post.description}
        </p>
      )}

      <!-- Meta -->
      <div class="mt-4 flex items-center gap-3 text-xs text-primary-500">
        <time datetime={post.pubDate.toISOString()}>
          {formatDateShort(post.pubDate)}
        </time>
        <span>&middot;</span>
        <span>{post.readingTime} menit baca</span>
      </div>

      <!-- Tags -->
      {post.tags && post.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <span class="text-xs text-primary-500">#{tag}</span>
          ))}
        </div>
      )}
    </div>

    {isFeatured && (
      <div class="shrink-0 self-start lg:self-center">
        <span class="inline-flex items-center gap-1 whitespace-nowrap rounded-lg bg-accent-600/10 px-4 py-2 text-sm font-medium text-accent-400 transition-colors group-hover:bg-accent-600/20">
          Baca Artikel
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </span>
      </div>
    )}
  </a>
</article>
