---
export interface Props {
  items: Array<{ text: string; href?: string }>
}

const { items } = Astro.props
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-primary-500">
    <li>
      <a href="/" class="transition-colors hover:text-primary-300">Home</a>
    </li>
    {items.map((item) => (
      <li class="flex items-center gap-1">
        <svg class="h-3 w-3 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-primary-300">
            {item.text}
          </a>
        ) : (
          <span class="text-primary-50 font-medium" aria-current="page">
            {item.text}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
