---
import { SITE } from '../config/site'
---

<!-- Search trigger button -->
<button id="search-trigger" class="rounded-md p-2 text-primary-500 transition-colors hover:bg-primary-100 hover:text-primary-700 dark:hover:bg-primary-800 dark:hover:text-primary-300" aria-label="Search">
  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
  </svg>
</button>

<!-- Search Dialog -->
<dialog id="search-dialog" class="fixed inset-0 z-50 h-full w-full bg-black/70 p-0 backdrop:bg-black/70">
  <div class="mx-auto mt-[15vh] max-w-xl rounded-xl border border-primary-700 bg-primary-900 p-4 shadow-2xl shadow-black/50">
    <div class="flex items-center gap-3 border-b border-primary-800 pb-3">
      <svg class="h-5 w-5 shrink-0 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input
        id="search-input"
        type="search"
        class="flex-1 bg-transparent text-primary-100 outline-none placeholder:text-primary-500"
        placeholder="Cari artikel..."
        autofocus
      />
      <kbd class="hidden rounded-md border border-primary-700 bg-primary-800 px-2 py-0.5 text-xs text-primary-400 sm:inline-block">
        ESC
      </kbd>
    </div>
    <div id="search-results" class="mt-3 max-h-[50vh] overflow-y-auto">
      <p class="py-8 text-center text-sm text-primary-400">
        Ketik untuk mencari artikel...
      </p>
    </div>
  </div>
</dialog>

<script>
  const trigger = document.getElementById('search-trigger')
  const dialog = document.getElementById('search-dialog')
  const input = document.getElementById('search-input')
  const results = document.getElementById('search-results')

  function openDialog() {
    dialog?.showModal()
    input?.focus()
  }

  function closeDialog() {
    dialog?.close()
  }

  trigger?.addEventListener('click', openDialog)

  dialog?.addEventListener('close', () => {
    if (input) input.value = ''
    if (results) results.innerHTML = '<p class="py-8 text-center text-sm text-primary-400">Ketik untuk mencari artikel...</p>'
  })

  // Keyboard shortcut
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault()
      openDialog()
    }
    if (e.key === 'Escape') {
      closeDialog()
    }
  })

  // Click outside to close
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) closeDialog()
  })

  // Pagefind integration
  if (input && results) {
    let debounceTimer

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer)
      const query = input.value.trim()

      if (!query) {
        results.innerHTML = '<p class="py-8 text-center text-sm text-primary-400">Ketik untuk mencari artikel...</p>'
        return
      }

      debounceTimer = setTimeout(async () => {
        results.innerHTML = '<p class="py-8 text-center text-sm text-primary-400">Mencari...</p>'

        try {
          const pagefind = await import('/pagefind/pagefind.js')
          const search = await pagefind.search(query)
          const resultsData = await Promise.all(
            search.results.slice(0, 10).map((r) => r.data())
          )

          if (resultsData.length === 0) {
            results.innerHTML = '<p class="py-8 text-center text-sm text-primary-400">Tidak ditemukan hasil untuk "' + query + '"</p>'
            return
          }

          results.innerHTML = resultsData
            .map(
              (r) =>
                `<a href="${r.url}" class="flex flex-col gap-1 rounded-lg p-3 transition-colors hover:bg-primary-100 dark:hover:bg-primary-800">
                  <span class="font-medium text-primary-950 dark:text-primary-50">${r.meta.title}</span>
                  <span class="text-sm text-primary-500 line-clamp-1">${r.excerpt}</span>
                </a>`
            )
            .join('')
        } catch {
          results.innerHTML = '<p class="py-8 text-center text-sm text-primary-400">Gagal memuat pencarian. Coba refresh halaman.</p>'
        }
      }, 300)
    })
  }
</script>
