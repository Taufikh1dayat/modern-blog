---
import { SITE } from '../config/site'
---

<section class="relative overflow-hidden border-b border-primary-800/50 bg-gradient-to-b from-primary-900/80 via-primary-950 to-primary-950">
  <!-- Subtle grid overlay -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:64px_64px]"></div>

  <div class="container-page relative py-24 text-center lg:py-36">
    <!-- Animated heading -->
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-7xl">
      <span class="animate-fade-up inline-block">Belajar</span>{' '}
      <span class="animate-fade-up animate-fade-up-delay-1 inline-block">
        <span class="bg-gradient-to-r from-accent-400 via-blue-400 to-accent-300 bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient">Teknologi</span>
      </span>{' '}
      <span class="animate-fade-up animate-fade-up-delay-2 inline-block">Terbaru</span>
    </h1>

    <!-- Typewriting subtitle -->
    <p id="typewriter" class="mx-auto mt-6 max-w-2xl text-lg text-primary-400 leading-relaxed min-h-[1.8em]">
      <span id="typewriter-text"></span>
      <span id="typewriter-cursor" class="inline-block w-[2px] h-[1em] bg-accent-400 ml-0.5 animate-pulse align-middle"></span>
    </p>

    <!-- Animated CTAs -->
    <div class="animate-fade-up animate-fade-up-delay-4 mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/articles"
        class="group relative rounded-xl bg-accent-600 px-8 py-3.5 text-sm font-medium text-white transition-all hover:bg-accent-500 hover:scale-105 active:scale-95"
      >
        Lihat Artikel
      </a>
      <a
        href="/categories"
        class="group relative rounded-xl border border-primary-700 bg-primary-900/50 px-8 py-3.5 text-sm font-medium text-primary-300 transition-all hover:border-primary-500 hover:text-primary-50 hover:bg-primary-800/50 hover:scale-105 active:scale-95"
      >
        Jelajahi Kategori
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes gradient {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 100% center; }
  }
  .animate-gradient {
    animation: gradient 4s ease infinite;
  }
</style>

<script>
  const words = [
    'Blog tentang teknologi, pemrograman, dan pengembangan web modern.',
    'Tutorial React, Astro, Tailwind CSS, dan TypeScript.',
    'Tips & trik performa web, SEO, dan optimasi gambar.',
    'Koding bareng, belajar bareng, tumbuh bareng.',
  ]

  let wordIdx = 0
  let charIdx = 0
  let isDeleting = false
  let isPaused = false

  const el = document.getElementById('typewriter-text')
  if (el) {
    function type() {
      const current = words[wordIdx]

      if (isPaused) {
        isPaused = false
        isDeleting = true
        setTimeout(type, 50)
        return
      }

      if (!isDeleting) {
        el.textContent = current.slice(0, charIdx + 1)
        charIdx++

        if (charIdx === current.length) {
          isPaused = true
          setTimeout(type, 2500)
          return
        }
        setTimeout(type, 45 + Math.random() * 60)
      } else {
        el.textContent = current.slice(0, charIdx)
        charIdx--

        if (charIdx < 0) {
          isDeleting = false
          charIdx = 0
          wordIdx = (wordIdx + 1) % words.length
          setTimeout(type, 400)
          return
        }
        setTimeout(type, 25 + Math.random() * 40)
      }
    }

    setTimeout(type, 800)
  }
</script>
