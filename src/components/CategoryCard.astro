---
export interface Props {
  name: string
  count: number
}

const { name, count } = Astro.props
---

<a
  href={`/categories/${encodeURIComponent(name.toLowerCase())}`}
  class="group block rounded-xl border border-primary-200 bg-white p-6 transition-all duration-200 ease-out hover:border-primary-300 hover:shadow-md hover:-translate-y-0.5 dark:border-primary-800 dark:bg-primary-900/50 dark:hover:border-accent-600/50 dark:hover:bg-primary-900 dark:hover:shadow-accent-500/5"
>
  <h3 class="text-lg font-semibold text-primary-950 transition-colors duration-200 group-hover:text-accent-600 dark:text-primary-50 dark:group-hover:text-accent-400">
    {name}
  </h3>
  <p class="mt-1 text-sm text-primary-500">
    {count} {count === 1 ? 'artikel' : 'artikel'}
  </p>
</a>
