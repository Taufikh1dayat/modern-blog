---
export interface Props {
  currentPage: number
  totalPages: number
  base: string
}

const { currentPage, totalPages, base } = Astro.props

function pageUrl(page: number): string {
  if (page <= 1) return base
  return `${base}/page/${page}`
}
---

<nav aria-label="Pagination" class="mt-12 flex items-center justify-center gap-2">
  <!-- Prev -->
  {currentPage > 1 ? (
    <a
      href={pageUrl(currentPage - 1)}
      class="rounded-md border border-primary-800 px-4 py-2 text-sm text-primary-400 transition-colors hover:bg-primary-800 hover:text-primary-50"
    >
      Sebelumnya
    </a>
  ) : (
    <span class="rounded-md border border-primary-800 px-4 py-2 text-sm text-primary-600 cursor-not-allowed">
      Sebelumnya
    </span>
  )}

  <!-- Page Numbers -->
  <div class="hidden gap-1 sm:flex">
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
      <a
        href={pageUrl(page)}
        class={`rounded-md px-3 py-2 text-sm transition-colors ${
          page === currentPage
            ? 'bg-accent-600 text-white'
            : 'text-primary-400 hover:bg-primary-800 border border-primary-800'
        }`}
      >
        {page}
      </a>
    ))}
  </div>

  <span class="text-sm text-primary-500 sm:hidden">
    Halaman {currentPage} dari {totalPages}
  </span>

  <!-- Next -->
  {currentPage < totalPages ? (
    <a
      href={pageUrl(currentPage + 1)}
      class="rounded-md border border-primary-800 px-4 py-2 text-sm text-primary-400 transition-colors hover:bg-primary-800 hover:text-primary-50"
    >
      Selanjutnya
    </a>
  ) : (
    <span class="rounded-md border border-primary-800 px-4 py-2 text-sm text-primary-600 cursor-not-allowed">
      Selanjutnya
    </span>
  )}
</nav>
