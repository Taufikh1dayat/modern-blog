---
import { SITE } from '../config/site'
import ThemeToggle from './ThemeToggle.astro'
---

<nav class="sticky top-0 z-50 border-b border-primary-200/50 dark:border-primary-800/50 bg-white/80 dark:bg-primary-950/80 backdrop-blur-lg">
  <div class="container-page flex h-16 items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center gap-2 transition-all duration-300 hover:scale-[1.02]">
      <span class="text-xl font-bold tracking-tight text-primary-950 dark:text-primary-50 hover:text-accent-400 transition-colors duration-300">
        {SITE.title}
      </span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-1 md:flex">
      {SITE.nav.map((item) => (
        <a
          href={item.link}
          class="group relative px-3 py-2 text-sm font-medium text-primary-600 dark:text-primary-400 transition-all duration-200 hover:text-primary-950 dark:hover:text-primary-50"
        >
          {item.text}
          <span class="absolute bottom-0 left-1/2 h-[2px] w-0 -translate-x-1/2 rounded-full bg-accent-400 transition-all duration-300 ease-out group-hover:w-[80%]"></span>
        </a>
      ))}
      <div class="ml-4 flex items-center gap-2">
        <a
          href={SITE.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full p-2 text-primary-500 transition-all duration-200 hover:scale-110 hover:text-primary-600 dark:hover:text-primary-300 hover:bg-primary-100/50 dark:hover:bg-primary-800/50"
          aria-label="GitHub"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile Nav Trigger -->
    <div class="flex items-center gap-3 md:hidden">
      <ThemeToggle />
      <button id="mobile-menu-btn" class="relative p-2 text-primary-600 dark:text-primary-400 transition-all duration-200 hover:scale-110 hover:text-primary-950 dark:hover:text-primary-50" aria-label="Toggle menu">
        <div id="hamburger-box" class="flex h-5 w-5 flex-col items-center justify-center gap-[4.5px] transition-all duration-300">
          <span id="bar-top" class="block h-[2px] w-5 rounded-full bg-current transition-all duration-300 ease-out"></span>
          <span id="bar-mid" class="block h-[2px] w-5 rounded-full bg-current transition-all duration-300 ease-out"></span>
          <span id="bar-bot" class="block h-[2px] w-5 rounded-full bg-current transition-all duration-300 ease-out"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="max-h-0 overflow-hidden border-t border-primary-200 dark:border-primary-800 transition-all duration-400 ease-in-out md:hidden">
    <div id="mobile-menu-inner" class="container-page flex flex-col gap-1 py-3">
      {SITE.nav.map((item, i) => (
        <a
          href={item.link}
          class="nav-mobile-item rounded-lg px-4 py-2.5 text-sm font-medium text-primary-600 dark:text-primary-400 transition-all duration-200 hover:bg-primary-100 dark:hover:bg-primary-800/60 hover:text-primary-950 dark:hover:text-primary-50 hover:translate-x-1"
        >
          {item.text}
        </a>
      ))}
      <a
        href={SITE.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-mobile-item flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-medium text-primary-600 dark:text-primary-400 transition-all duration-200 hover:bg-primary-100 dark:hover:bg-primary-800/60 hover:text-primary-950 dark:hover:text-primary-50 hover:translate-x-1"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        GitHub
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  const barTop = document.getElementById('bar-top')
  const barMid = document.getElementById('bar-mid')
  const barBot = document.getElementById('bar-bot')
  const items = document.querySelectorAll('.nav-mobile-item')

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open')

    if (menu) {
      if (isOpen) {
        menu.style.maxHeight = menu.scrollHeight + 'px'
        // Hamburger → X
        barTop?.style.setProperty('transform', 'translateY(6.5px) rotate(45deg)')
        barMid?.style.setProperty('opacity', '0')
        barMid?.style.setProperty('transform', 'scaleX(0)')
        barBot?.style.setProperty('transform', 'translateY(-6.5px) rotate(-45deg)')
        // Stagger items
        items.forEach((item, i) => {
          item.style.setProperty('opacity', '0')
          item.style.setProperty('transform', 'translateX(-8px)')
          requestAnimationFrame(() => {
            item.style.setProperty('transition', `all 0.25s ease-out ${0.05 + i * 0.04}s`)
            item.style.setProperty('opacity', '1')
            item.style.setProperty('transform', 'translateX(0)')
          })
        })
      } else {
        menu.style.maxHeight = '0px'
        barTop?.style.setProperty('transform', 'translateY(0) rotate(0)')
        barMid?.style.setProperty('opacity', '1')
        barMid?.style.setProperty('transform', 'scaleX(1)')
        barBot?.style.setProperty('transform', 'translateY(0) rotate(0)')
        items.forEach((item) => {
          item.style.setProperty('opacity', '0')
          item.style.setProperty('transform', 'translateX(-8px)')
        })
      }
    }
  })

  // Reset items on page load (hidden state)
  items.forEach((item) => {
    item.style.setProperty('opacity', '0')
    item.style.setProperty('transform', 'translateX(-8px)')
  })
</script>